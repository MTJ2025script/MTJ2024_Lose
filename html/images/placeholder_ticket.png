<svg xmlns="http://www.w3.org/2000/svg" width="540" height="200" viewBox="0 0 540 200">
  <defs>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1a1a2a"/>
      <stop offset="45%" stop-color="#2a2a4a"/>
      <stop offset="100%" stop-color="#0a0a1a"/>
    </linearGradient>
    <pattern id="p" width="30" height="30" patternUnits="userSpaceOnUse">
      <text x="15" y="22" font-size="18" text-anchor="middle" fill="rgba(255,255,255,0.04)" font-family="serif">♦</text>
    </pattern>
    <pattern id="q" width="60" height="60" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="60" stroke="rgba(255,255,255,0.03)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="540" height="200" fill="url(#g)"/>
  <rect width="540" height="200" fill="url(#p)"/>
  <rect width="540" height="200" fill="url(#q)"/>
  <rect x="0" y="0" width="540" height="4" fill="rgba(255,255,255,0.1)"/>
  <rect x="0" y="196" width="540" height="4" fill="rgba(0,0,0,0.2)"/>
  <text x="270" y="115" font-family="'Segoe UI',Arial,sans-serif" font-size="44" font-weight="900" text-anchor="middle" fill="rgba(255,255,255,0.12)" letter-spacing="8">LOS</text>
  <text x="270" y="155" font-family="Arial,sans-serif" font-size="11" text-anchor="middle" fill="rgba(255,255,255,0.07)" letter-spacing="4">♠ ♥ ♦ ♣ MTJ CASINO ♣ ♦ ♥ ♠</text>
  <text x="270" y="185" font-family="Arial,sans-serif" font-size="9" text-anchor="middle" fill="rgba(255,255,255,0.06)" letter-spacing="3">[ PLATZHALTER – BITTE MIT EIGENEM BILD ERSETZEN ]</text>
</svg>
